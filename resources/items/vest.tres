[gd_resource type="Resource" script_class="EquippableItemData" format=3]

[ext_resource type="Script" path="res://scripts/items/EquippableItemData.cs" id="1_item"]
[ext_resource type="Script" path="res://scripts/items/capabilities/ItemCapabilityData.cs" id="2_base"]
[ext_resource type="Script" path="res://scripts/items/capabilities/ArmorCapabilityData.cs" id="3_armor"]
[ext_resource type="Script" path="res://scripts/stats/concrete_stats/BaseArmorStat.cs" id="4_stat"]

[sub_resource type="Resource" id="Resource_armorstat"]
script = ExtResource("4_stat")
BaseValue = 2

[sub_resource type="Resource" id="Resource_armor"]
script = ExtResource("3_armor")
ArmorStat = SubResource("Resource_armorstat")

[resource]
script = ExtResource("1_item")
Name = "Ballistic Vest"
UnlimitedStock = true
Description = "Woven plate carrier. Stops some of what is coming."
Capabilities = Array[ExtResource("2_base")]([SubResource("Resource_armor")])

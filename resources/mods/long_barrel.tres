[gd_resource type="Resource" script_class="MultiStatMod" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/stats/MultiStatMod.cs" id="1_multi"]
[ext_resource type="Script" path="res://scripts/stats/concrete_mods/RangeStatMod.cs" id="2_range"]
[ext_resource type="Script" path="res://scripts/stats/StatModifier.cs" id="3_modifier"]

[sub_resource type="Resource" id="mod_add10"]
script = ExtResource("3_modifier")
Operation = 0
Value = 10.0

[sub_resource type="Resource" id="range_statmod"]

[gd_resource type="Resource" script_class="BattleTypeData" format=3]

[ext_resource type="Resource" path="res://resources/maps/defusal_map.tres" id="1_map"]
[ext_resource type="Script" path="res://scripts/battle/types/BattleTypeData.cs" id="2_type"]
[ext_resource type="Script" path="res://scripts/battle/types/FactionDeploymentData.cs" id="3_faction"]
[ext_resource type="Script" path="res://scripts/battle/types/RosterEntryData.cs" id="4_roster"]
[ext_resource type="Script" path="res://scripts/battle/types/ObjectPlacementData.cs" id="5_object"]
[ext_resource type="Script" path="res://scripts/battle/types/ObjectExpirySystemData.cs" id="6_system"]
[ext_resource type="Script" path="res://scripts/battle/objectives/DefuseAllBombsObjectiveData.cs" id="7_defuse"]
[ext_resource type="Script" path="res://scripts/battle/objectives/EliminateAllOpposingForcesObjectiveData.cs" id="8_eliminate"]
[ext_resource type="Script" path="res://scripts/battle/objectives/directives/EndBattleDirectiveData.cs" id="9_end"]
[ext_resource type="Resource" path="res://resources/combatants/trooper.tres" id="10_trooper"]
[ext_resource type="Resource" path="res://resources/combatants/grunt.tres" id="11_grunt"]
[ext_resource type="Resource" path="res://resources/weapons/service_pistol.tres" id="12_pistol"]
[ext_resource type="Resource" path="res://resources/battle_objects/alien_bomb.tres" id="13_bomb"]
[ext_resource type="Script" path="res://scripts/combatants/FactionData.cs" id="14_faction_data"]

[sub_resource type="Resource" id="Resource_end_victory"]
script = ExtResource("9_end")
Outcome = 1

[sub_resource type="Resource" id="Resource_end_defeat"]
script = ExtResource("9_end")
Outcome = 2

[sub_resource type="Resource" id="Resource_player_objective"]
script = ExtResource("7_defuse")
OnComplete = SubResource("Resource_end_victory")
OnFail = SubResource("Resource_end_defeat")

[sub_resource type="Resource" id="Resource_enemy_objective"]
script = ExtResource("8_eliminate")
OnComplete = SubResource("Resource_end_defeat")

[sub_resource type="Resource" id="Resource_trooper_entry"]
script = ExtResource("4_roster")
Combatant = ExtResource("10_trooper")
Quantity = 3
Weapon = ExtResource("12_pistol")

[sub_resource type="Resource" id="Resource_grunt_entry"]
script = ExtResource("4_roster")
Combatant = ExtResource("11_grunt")
Quantity = 3

[sub_resource type="Resource" id="Resource_player_faction"]
script = ExtResource("14_faction_data")
Name = "Xenonauts"
Description = "Bomb defusal team"

[sub_resource type="Resource" id="Resource_enemy_faction"]
script = ExtResource("14_faction_data")
Name = "Aliens"
Description = "Bomb-planting invaders"

[sub_resource type="Resource" id="Resource_player_deployment"]
script = ExtResource("3_faction")
Faction = SubResource("Resource_player_faction")
Roster = Array[ExtResource("4_roster")]([SubResource("Resource_trooper_entry")])
Objectives = Array[ExtResource("7_defuse")]([SubResource("Resource_player_objective")])

[sub_resource type="Resource" id="Resource_enemy_deployment"]
script = ExtResource("3_faction")
Faction = SubResource("Resource_enemy_faction")
Roster = Array[ExtResource("4_roster")]([SubResource("Resource_grunt_entry")])
Objectives = Array[ExtResource("8_eliminate")]([SubResource("Resource_enemy_objective")])

[sub_resource type="Resource" id="Resource_bomb_placement"]
script = ExtResource("5_object")
SpecialObject = ExtResource("13_bomb")
Positions = Array[Vector3i]([Vector3i(3, 0, 3), Vector3i(4, 0, 4)])

[sub_resource type="Resource" id="Resource_expiry_system"]
script = ExtResource("6_system")

[resource]
script = ExtResource("2_type")
MapPool = Array[ExtResource("1_map")]([ExtResource("1_map")])
Factions = Array[ExtResource("3_faction")]([SubResource("Resource_player_deployment"), SubResource("Resource_enemy_deployment")])
PlayerFactionIndex = 0
Objects = Array[ExtResource("5_object")]([SubResource("Resource_bomb_placement")])
Systems = Array[ExtResource("6_system")]([SubResource("Resource_expiry_system")])
Name = "Bomb Defusal"
Description = "Defuse both bombs before the timer expires"

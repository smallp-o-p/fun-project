<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
    <RunConfiguration>
        <MaxCpuCount>2</MaxCpuCount>
        <TestAdaptersPaths>./test</TestAdaptersPaths>
        <ResultsDirectory>./TestResults</ResultsDirectory>
        <!-- Healthy full-suite runs finish in well under a minute; this only bounds a
             crashed or wedged Godot host instead of hanging the session for 30 minutes. -->
        <TestSessionTimeout>300000</TestSessionTimeout>
        <TreatNoTestsAsError>true</TreatNoTestsAsError>
        <!-- Environment variables available to tests -->
        <EnvironmentVariables>
            <GODOT_BIN>C:\Program Files\Godot_v4.7.2-stable_mono_win64\Godot_v4.7.2-stable_mono_win64.exe</GODOT_BIN>
        </EnvironmentVariables>
    </RunConfiguration>

    <!-- Test result loggers -->
    <LoggerRunSettings>
        <Loggers>
            <Logger friendlyName="console" enabled="True">
                <Configuration>
                    <Verbosity>normal</Verbosity>
                </Configuration>
            </Logger>
            <!-- Godot/GdUnit emits raw ANSI ESC bytes that the VSTest HTML logger cannot serialize. -->
            <Logger friendlyName="html" enabled="False">
                <Configuration>
                    <LogFileName>test-result.html</LogFileName>
                </Configuration>
            </Logger>
            <Logger friendlyName="trx" enabled="True">
                <Configuration>
                    <LogFileName>test-result.trx</LogFileName>
                </Configuration>
            </Logger>
        </Loggers>
    </LoggerRunSettings>

    <!-- GdUnit4-specific configuration -->
    <GdUnit4>
        <!-- Godot's verbose flag is deliberately omitted: it logs every resource load
             and the captured output bloats the TRX and slows every test run. -->

        <!-- Test display name format: SimpleName or FullyQualifiedName -->
        <DisplayName>FullyQualifiedName</DisplayName>

        <!-- Capture stdout from test cases -->
        <CaptureStdOut>true</CaptureStdOut>

        <!-- Compilation timeout for large projects (milliseconds) -->
        <CompileProcessTimeout>120000</CompileProcessTimeout>
    </GdUnit4>
</RunSettings>

; Engine configuration file.
; Keep this test project separate from the main Godot project so VSTest can
; launch GdUnit from the fun-project-test subproject.

config_version=5

[application]

config/name="fun-project-test"
config/features=PackedStringArray("4.6", "C#")

[dotnet]

project/assembly_name="fun-project-test"

[rendering]

renderer/rendering_method="mobile"

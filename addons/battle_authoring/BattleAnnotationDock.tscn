[gd_scene format=3]

[node name="BattleAnnotationDock" type="EditorDock"]
title = "Box annotations"
default_slot = 5
global = false
transient = true

[node name="Panel" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3

[node name="Status" type="Label" parent="Panel"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
autowrap_mode = 3

[node name="Inspect" type="Button" parent="Panel"]
layout_mode = 2
text = "Inspect selected box"

[node name="Reset" type="Button" parent="Panel"]
layout_mode = 2
text = "Reset annotations…"

[node name="ConfirmReset" type="ConfirmationDialog" parent="."]
title = "Reset box annotations?"
dialog_text = "Clear all box flags and unlock painting? The painted shape stays.\nThis reset can be undone with Godot's native Undo."
